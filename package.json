{
  "name": "binance-contract-trading-full-stack",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "dev:web": "turbo run dev:bare -F web --",
    "dev:server": "turbo run dev -F server --",
    "db:push": "turbo run db:push -F @binance-contract-trading-full-stack/db --",
    "db:studio": "turbo run db:studio -F @binance-contract-trading-full-stack/db --",
    "db:generate": "turbo run db:generate -F @binance-contract-trading-full-stack/db --",
    "db:migrate": "turbo run db:migrate -F @binance-contract-trading-full-stack/db --",
    "db:update:dev":"pnpm run db:generate && pnpm run db:migrate",
    "deploy": "turbo run deploy -F @binance-contract-trading-full-stack/infra --",
    "destroy": "turbo run destroy -F @binance-contract-trading-full-stack/infra --",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./apps/native/ && varlock codegen --path ./packages/db/",
    "test": "turbo run test",
    "docs:binance": "node docs/vendor/binance/fetch.mjs"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@binance-contract-trading-full-stack/config": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@types/node": "catalog:",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "varlock": "catalog:"
  },
  "packageManager": "pnpm@11.8.0"
}
