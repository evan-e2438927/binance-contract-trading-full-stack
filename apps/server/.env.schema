# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @dynamic @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# @type=string(minLength=1)
BINANCE_API_KEY=

# @type=string(minLength=1)
BINANCE_SECRET_KEY=

# ——— 鉴权（第 12 讲）———

# 签 JWT 的 HS256 密钥，至少 32 个字符。生成：openssl rand -base64 48
# @type=string(minLength=32)
JWT_SECRET=

# 邮箱验证码走 Resend 发信。不配：开发环境验证码打到服务端日志，生产环境邮箱登录返回 SERVICE_UNAVAILABLE
# @optional
RESEND_API_KEY=

# 发件人。Resend 只能用自己验证过的域名发信（gmail.com 这类公共域名不行），例如：模拟交易 <login@你的域名>
# 没有域名时测试用 onboarding@resend.dev：只能发到注册 Resend 的那个邮箱
# @optional @public
EMAIL_FROM=

# Google OAuth（Google Cloud Console → 凭据 → OAuth 客户端 ID，类型"Web 应用"）。三个都配了 Google 登录才开启
# @optional @public
GOOGLE_CLIENT_ID=

# @optional
GOOGLE_CLIENT_SECRET=

# 要和 Google 后台"已获授权的重定向 URI"完全一致，例如 http://localhost:3000/auth/google/callback
# @optional @public @type=url
GOOGLE_REDIRECT_URI=

# Sentry 报错收集（server 项目的 DSN，和 web 的 NEXT_PUBLIC_SENTRY_DSN 不是同一个）。不配 = 不启用
# @optional
SENTRY_DSN=

# 版本标识，用于 Sentry 按版本归类。留空 = 自动用 package.json 的 version（如 server@0.1.0）；填了就用填的值
# @optional @public
SENTRY_RELEASE=
