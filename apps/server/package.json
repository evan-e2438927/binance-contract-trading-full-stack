{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.mjs",
    "env:generate": "varlock codegen",
    "market:watch": "tsx src/market/watch.ts"
  },
  "dependencies": {
    "@binance-contract-trading-full-stack/db": "workspace:*",
    "@binance-contract-trading-full-stack/engine": "workspace:*",
    "@binance-contract-trading-full-stack/shared": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.7",
    "varlock": "catalog:",
    "zod": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@binance-contract-trading-full-stack/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.23.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  },
  "trustedDependencies": [
    "supabase"
  ]
}
